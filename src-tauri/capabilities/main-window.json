{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window: everything the UI needs, nothing more.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "allow-app-info",
    "allow-get-settings",
    "allow-set-settings",
    "allow-vault-status",
    "allow-select-database",
    "allow-choose-database",
    "allow-choose-key-file",
    "allow-unlock",
    "allow-lock",
    "allow-forget-recent",
    "allow-list-groups",
    "allow-list-entries",
    "allow-search-entries",
    "allow-get-entry",
    "allow-get-custom-icons",
    "allow-reveal-field",
    "allow-copy-field",
    "allow-get-totp",
    "allow-open-url",
    "allow-show-quick-search",
    "allow-hotkey-status",
    "allow-pause-hotkeys",
    "allow-get-autostart",
    "allow-set-autostart"
  ]
}
