{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-window",
  "description": "The quick search box: search, copy and unlock only. It cannot browse groups or reveal values.",
  "windows": ["quick"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-size",
    "allow-app-info",
    "allow-get-settings",
    "allow-vault-status",
    "allow-unlock",
    "allow-search-entries",
    "allow-get-custom-icons",
    "allow-copy-field",
    "allow-hide-quick-search",
    "allow-autotype-candidates",
    "allow-autotype-entry"
  ]
}
